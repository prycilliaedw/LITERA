# ============================================================
# LITERA - Vercel Container Deployment
# ============================================================

# ------------------------------------------------------------
# Stage 1: Install PHP dependencies
# IMPORTANT: do not run Composer scripts here because the
# Laravel application files (including artisan) are not copied
# into this stage yet.
# ------------------------------------------------------------
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts


# ------------------------------------------------------------
# Stage 2: Build frontend assets
# Flux CSS is inside vendor/livewire/flux.
# ------------------------------------------------------------
FROM node:24-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY --from=vendor /app/vendor ./vendor

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build


# ------------------------------------------------------------
# Stage 3: Laravel runtime
# ------------------------------------------------------------
FROM dunglas/frankenphp:php8.4-bookworm

WORKDIR /app

RUN install-php-extensions \
    pdo_mysql \
    mbstring \
    xml \
    curl \
    fileinfo \
    opcache

COPY . .

COPY --from=vendor /app/vendor ./vendor

COPY --from=frontend /app/public/build ./public/build

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache

RUN chmod -R 775 storage bootstrap/cache

# Composer scripts were intentionally skipped in the vendor stage
# because artisan was not available there. Run package discovery
# now that the full Laravel application is present.
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache

RUN chmod -R 775 storage bootstrap/cache

CMD ["frankenphp", "php-server", "--root", "/app/public"]
